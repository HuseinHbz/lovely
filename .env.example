# ------------------------------------------------------------------
# پرونده‌ی گرگ و جوجه‌تیغی — نمونه‌ی متغیرهای محیطی
#
# این فایل در مخزن می‌ماند. فایل واقعی `.env` هرگز commit نمی‌شود.
#
# هیچ‌کدام مقدار پیش‌فرض ندارند و هیچ‌کدام اختیاری نیستند: اگر یکی خالی باشد
# سرور با پیام واضح بالا نمی‌آید (`instrumentation.ts` → `lib/env.ts`).
# یک سایت خصوصی که با توکن پیش‌فرض بالا بیاید، خصوصی نیست.
# ------------------------------------------------------------------

# توکن دسترسی. تولید:  openssl rand -hex 16
# این همان چیزی است که در صفحه‌ی /gate وارد می‌شود.
ACCESS_TOKEN=

# سکرت امضای کوکی. تولید:  openssl rand -hex 32
# خود توکن در کوکی نمی‌نشیند؛ کوکی HMAC-SHA256 با همین سکرت است.
# عوض کردنش همه‌ی نشست‌های باز را باطل می‌کند.
SESSION_SECRET=

# تاریخ انقضای لینک، ISO 8601. مثال:  2026-12-31T23:59:59Z
# بعد از این لحظه همه‌چیز — حتی با کوکی معتبر — به /expired می‌رود.
LINK_EXPIRES_AT=

# آدرس نهایی سایت، بدون اسلش انتهایی. مثال: https://example.ir
SITE_URL=

# قاعده ۲: هیچ تله‌متری. این را روی 1 نگه دارید.
NEXT_TELEMETRY_DISABLED=1
