# ------------------------------------------------------------------
# پرونده‌ی گرگ و جوجه‌تیغی — نمونه‌ی متغیرهای محیطی
# این فایل در مخزن می‌ماند. فایل واقعی `.env` هرگز commit نمی‌شود.
# ------------------------------------------------------------------

# توکن دسترسی به سایت. در نصب با `openssl rand -hex 16` تولید می‌شود.
# بدون این توکن هیچ صفحه‌ای از داستان باز نمی‌شود (فاز ۵).
ACCESS_TOKEN=

# تاریخ انقضای لینک — میلی‌ثانیه از epoch یا ISO 8601.
# بعد از این لحظه، سایت صفحه‌ی «این پرونده بسته شد» را نشان می‌دهد.
# خالی بگذارید تا لینک منقضی نشود.
LINK_EXPIRES_AT=

# آدرس نهایی سایت، بدون اسلش انتهایی. مثال: https://example.ir
SITE_URL=

# قاعده ۲: هیچ تله‌متری. این را روی 1 نگه دارید.
NEXT_TELEMETRY_DISABLED=1
